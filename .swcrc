{
  "$schema": "https://json.schemastore.org/swcrc",
  "exclude": [".*\\.spec\\.ts$", ".*\\.test\\.ts$"],
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": "./",
    "paths": {
      "@/src/*": ["src/*"],
      "@/tests/*": ["test/*"],
      "@common/*": ["src/common/*"]
    },
    "target": "esnext"
  },
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "minify": false
}

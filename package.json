{
  "name": "collaborative-document-service",
  "version": "0.5.0",
  "description": "Backend microservice, supporting real-time multi-user collaboration on a shared document.",
  "author": "Alkemio Foundation",
  "license": "EUPL-1.2",
  "main": "dist/main.js",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "overridesRationale": "workspace#036-distroless-wave-1 — CVE remediation for transitive deps that cannot resolve on their own. @nestjs/platform-fastify@11.1.x pins its dependencies EXACTLY ('fastify': '5.10.0', 'find-my-way': '9.6.0'), so `pnpm update` is a no-op and the fixed versions are unreachable without an override. Each override is a patch-level bump that satisfies the range the real consumer declares — fastify@5.10.0 itself declares find-my-way ^9.6.0, and ajv / @fastify/ajv-compiler declare fast-uri ^3.0.0. Fixes CVE-2026-47219 (find-my-way HTTP/2 DoS), CVE-2026-16221 and CVE-2026-18446 (fast-uri host confusion). Re-check on the next @nestjs/platform-fastify bump and drop any entry upstream has caught up with.",
  "pnpm": {
    "overrides": {
      "find-my-way@<9.7.0": "9.7.0",
      "fast-uri@<3.1.5": "3.1.6",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.3"
    }
  },
  "scripts": {
    "build": "node --run build:clean && nest build --path tsconfig.prod.json",
    "build:clean": "rimraf dist; exit 0",
    "prepare": "[ -f .husky/install.mjs ] && node .husky/install.mjs || true",
    "lint": "eslint . --ext .ts,.mts",
    "typos": "typos",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run --config test/config/vitest.config.ts",
    "test:ui": "vitest --ui --config test/config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config test/config/vitest.config.ts && open-cli coverage/index.html",
    "typecheck:native": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "collaboration",
    "hocuspocus",
    "ws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkem-io/collaborative-document-service.git"
  },
  "bugs": {
    "url": "https://github.com/alkem-io/collaborative-document-service/issues"
  },
  "homepage": "https://github.com/alkem-io/collaborative-document-service#readme",
  "dependencies": {
    "@hocuspocus/server": "^3.2.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "logform": "^2.7.0",
    "nest-winston": "^1.10.2",
    "rxjs": "^7.8.2",
    "winston": "^3.17.0",
    "yaml": "^2.8.1",
    "yjs": "^13.6.27"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "volta": {
    "node": "22.23.2",
    "pnpm": "10.34.5"
  },
  "devDependencies": {
    "@commitlint/types": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^14.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "@vitest/eslint-plugin": "^1.0.1",
    "globals": "^16.4.0",
    "open-cli": "^8.0.0",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-swc": "^1.5.1",
    "vite": "5.4.21",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^1.3.2"
  }
}
